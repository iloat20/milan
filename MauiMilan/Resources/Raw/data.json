{
  "Characters": [
    { "CharacterId": "char_ur_zhulong", "DisplayName": "烛龙 Zhulong", "Title": "昼夜之主", "World": "Shinwa", "Element": "Flame", "BaseRarity": 4, "BaseStats": [165,95,1250,19], "MaxStars": 7, "CanBreakthrough": true, "Lore": "上古山海经所载烛龙，睁眼为白昼、闭眼为长夜，吐息化为天火。漫威凤凰之力与DC火神之威在其体内共鸣，觉醒之日，星辰为之焚尽。", "TalentTreeId": "tree_zhulong" },
    { "CharacterId": "char_ur_wuxu", "DisplayName": "虚无 Wuxu", "Title": "万象终焉", "World": "Aether", "Element": "Void", "BaseRarity": 4, "BaseStats": [155,125,1150,17], "MaxStars": 7, "CanBreakthrough": true, "Lore": "山海经所载混沌之形，无面无相，万物归虚。漫威湮灭与DC反监视者的力量在此交汇，它来自维度裂隙深处，以星辰为食，所余唯有虚无。", "TalentTreeId": "tree_wuxu" },
    { "CharacterId": "ur_xingtian", "DisplayName": "刑天 Xingtian", "Title": "不死战神", "World": "Ironveil", "Element": "Metal", "BaseRarity": 4, "BaseStats": [170,155,1500,13], "MaxStars": 7, "CanBreakthrough": true, "Lore": "山海经刑天，断首仍以乳为目、以脐为口，执干戚而舞。漫威金刚狼的不愈与DC毁灭日的进化在其合金躯壳中重生，铁帷纪元最不屈的战士。", "TalentTreeId": "tree_xingtian" },
    { "CharacterId": "char_ur_kikyo", "DisplayName": "桔梗 Kikyo", "Title": "悲运的巫女", "World": "Shinwa", "Element": "Shadow", "BaseRarity": 4, "BaseStats": [158,90,1050,20], "MaxStars": 7, "CanBreakthrough": true, "Lore": "《犬夜叉》传奇巫女桔梗，灵力高强、清冷孤高。曾奉命守护四魂之玉，与半妖犬夜叉相知相爱，却遭奈落阴谋所害，含恨而终。后以陶土复生，带着前世记忆与执念独行于乱世，以破魔之箭净化众生、封印邪祟。她是不被世间的巫女，行走于生死之间，以悲悯之心超度亡魂。", "TalentTreeId": "tree_kikyo" },
    { "CharacterId": "char_ur_keqing", "DisplayName": "刻晴 Keqing", "Title": "玉衡星", "World": "Aether", "Element": "Thunder", "BaseRarity": 4, "BaseStats": [162,105,1150,21], "MaxStars": 7, "CanBreakthrough": true, "Lore": "《原神》璃月七星之玉衡星刻晴，勤勉正直、不信神明。她坚信人类的命运应由自己掌握，而非托付于仙家神力。身为雷元素使用者，她将雷电之力融入剑术，创造出独一无二的「云来剑法」。以凡人之躯比肩神明，以雷霆之势守护璃月。", "TalentTreeId": "tree_keqing" },
    { "CharacterId": "char_ssr_fenghuang", "DisplayName": "凤凰 Fenghuang", "Title": "涅槃圣禽", "World": "Shinwa", "Element": "Flame", "BaseRarity": 3, "BaseStats": [125,85,1050,16], "MaxStars": 6, "CanBreakthrough": true, "Lore": "山海经凤凰，五色而文，德义礼仁信。漫威凤凰女琴·葛蕾的念力与DC火星猎人的火焰在其羽翼中涅槃，浴火重生，不死不灭。", "TalentTreeId": "tree_fenghuang" },
    { "CharacterId": "char_ssr_xiangliu", "DisplayName": "相柳 Xiangliu", "Title": "九首毒厄", "World": "Aether", "Element": "Void", "BaseRarity": 3, "BaseStats": [118,95,1100,14], "MaxStars": 6, "CanBreakthrough": false, "Lore": "山海经相柳，九首蛇身，所到之处化为毒泽。漫威毒液的共生体与小丑的剧毒在其血液中流淌，吐息即瘟疫，触碰即腐蚀。", "TalentTreeId": "tree_xiangliu" },
    { "CharacterId": "char_ssr_leishen", "DisplayName": "雷神 Leishen", "Title": "雷霆裁决", "World": "Ironveil", "Element": "Thunder", "BaseRarity": 3, "BaseStats": [130,90,1000,17], "MaxStars": 6, "CanBreakthrough": false, "Lore": "山海经雷兽，龙身人头，腹中雷鸣。漫威雷神索尔的妙尔尼尔与DC宙斯的雷霆在其机械核心中锻造，以闪电审判一切。", "TalentTreeId": "tree_leishen" },
    { "CharacterId": "char_ssr_feilian", "DisplayName": "飞廉 Feilian", "Title": "风驰电掣", "World": "Shinwa", "Element": "Wind", "BaseRarity": 3, "BaseStats": [122,70,880,24], "MaxStars": 6, "CanBreakthrough": false, "Lore": "山海经飞廉，鹿身雀首，司掌风伯。漫威快银的神速与DC闪电侠的神速力在其血脉中奔袭，疾风迅雷，唯快不破。", "TalentTreeId": "tree_feilian" },
    { "CharacterId": "char_ssr_shangyang", "DisplayName": "商羊 Shangyang", "Title": "预知神鸟", "World": "Aether", "Element": "Star", "BaseRarity": 3, "BaseStats": [115,100,1080,15], "MaxStars": 6, "CanBreakthrough": false, "Lore": "山海经商羊，一足鸟身，预知风雨。漫威X教授的精神力与DC命运博士的纳布神盔赋予其预知未来的能力，以星象指引命运。", "TalentTreeId": "tree_shangyang" },
    { "CharacterId": "char_sr_suanni", "DisplayName": "狻猊 Suanni", "Title": "狮吼震魂", "World": "Shinwa", "Element": "Flame", "BaseRarity": 2, "BaseStats": [95,75,900,14], "MaxStars": 5, "CanBreakthrough": false, "Lore": "山海经狻猊，狮形豹步，食虎豹。漫威黑豹的振金战甲与DC蝙蝠侠的战术智慧在其血脉中传承，以狮吼震慑敌魂。", "TalentTreeId": "tree_suanni" },
    { "CharacterId": "char_sr_jingwei", "DisplayName": "精卫 Jingwei", "Title": "衔石填海", "World": "Aether", "Element": "Wind", "BaseRarity": 2, "BaseStats": [88,72,850,16], "MaxStars": 5, "CanBreakthrough": false, "Lore": "山海经精卫，炎帝之女溺于东海，化为神鸟衔石填海。漫威黑寡妇的坚韧与DC猫女的敏捷赋予其不屈意志，以柔克刚。", "TalentTreeId": "tree_jingwei" },
    { "CharacterId": "char_sr_qiongqi", "DisplayName": "穷奇 Qiongqi", "Title": "噬罪凶兽", "World": "Ironveil", "Element": "Metal", "BaseRarity": 2, "BaseStats": [100,88,980,11], "MaxStars": 5, "CanBreakthrough": false, "Lore": "山海经穷奇，状如牛蝟毛，性噬恶人。漫威死侍的再生与DC丧钟的精准射击在其机械兽躯中融合，以暴制暴。", "TalentTreeId": "tree_qiongqi" },
    { "CharacterId": "char_sr_xuanwu", "DisplayName": "旋龟 Xuanwu", "Title": "玄甲守护", "World": "Shinwa", "Element": "Earth", "BaseRarity": 2, "BaseStats": [92,115,1100,9], "MaxStars": 5, "CanBreakthrough": false, "Lore": "山海经旋龟，鸟首虺尾，其音如判木。漫威钢力士的钢躯与DC钢骨的机械防护化为玄龟坚甲，以守为攻。", "TalentTreeId": "tree_xuanwu" },
    { "CharacterId": "char_sr_bifang", "DisplayName": "毕方 Bifang", "Title": "焚羽烈鸟", "World": "Aether", "Element": "Thunder", "BaseRarity": 2, "BaseStats": [90,70,820,18], "MaxStars": 5, "CanBreakthrough": false, "Lore": "山海经毕方，一足鹤身，见则讹火。漫威猎鹰的翼装与DC鹰女的N金属羽翼化为雷电之翼，所过之处雷火交加。", "TalentTreeId": "tree_bifang" },
    { "CharacterId": "char_r_lili", "DisplayName": "狸力 LiLi", "Title": "遁地灵兽", "World": "Shinwa", "Element": "Earth", "BaseRarity": 1, "BaseStats": [72,65,750,12], "MaxStars": 4, "CanBreakthrough": false, "Lore": "山海经狸力，状如豚有距，其音如狗吠。漫威蚁人的缩放与DC原子侠的原子操控赋予其遁地穿土之能，身形虽小，来去无踪。", "TalentTreeId": "tree_lili" },
    { "CharacterId": "char_r_qinyuan", "DisplayName": "钦原 Qinyuan", "Title": "毒蜂刺羽", "World": "Aether", "Element": "Metal", "BaseRarity": 1, "BaseStats": [76,60,700,15], "MaxStars": 4, "CanBreakthrough": false, "Lore": "山海经钦原，蛰鸟兽则死，蛰木则枯。黄蜂女的蜂群战衣与黑金丝雀的声波在其机械蜂翼中融合，以毒针刺穿敌阵。", "TalentTreeId": "tree_qinyuan" },
    { "CharacterId": "char_r_sishu", "DisplayName": "跂踵 SiShu", "Title": "夜行游侠", "World": "Ironveil", "Element": "Shadow", "BaseRarity": 1, "BaseStats": [74,62,720,16], "MaxStars": 4, "CanBreakthrough": false, "Lore": "山海经跂踵，状如鹊而九尾，见则其国多疫。蜘蛛侠的蛛丝感应与DC夜翼的杂技格斗在其暗影战衣中觉醒，夜行无声。", "TalentTreeId": "tree_sishu" },
    { "CharacterId": "char_r_luoyu", "DisplayName": "蠃鱼 Luoyu", "Title": "渊海游灵", "World": "Shinwa", "Element": "Frost", "BaseRarity": 1, "BaseStats": [70,68,780,13], "MaxStars": 4, "CanBreakthrough": false, "Lore": "山海经蠃鱼，鱼身鸟翼，音如鸳鸯。漫威海王纳摩的深海之力与DC水行侠的亚特兰蒂斯之能在其鳞翼中流淌，御水而行。", "TalentTreeId": "tree_luoyu" },
    { "CharacterId": "char_r_dangang", "DisplayName": "当康 Dangang", "Title": "丰穗瑞兽", "World": "Aether", "Element": "Wind", "BaseRarity": 1, "BaseStats": [78,72,820,11], "MaxStars": 4, "CanBreakthrough": false, "Lore": "山海经当康，状如豚而有牙，其鸣自叫，见则天下大穰。漫威野兽的蛮力与DC火星猎人的兽性在其瑞兽之躯中苏醒，以丰收之名为战。", "TalentTreeId": "tree_dangang" }
