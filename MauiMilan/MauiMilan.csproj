<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>Milan.Maui</RootNamespace>
		<ApplicationId>com.milan.game</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationTitle>Milan</ApplicationTitle>
		<AndroidManifest>Platforms\Android\AndroidManifest.xml</AndroidManifest>
		<!-- Shader 渐变（RadialGradient/LinearGradient/SweepGradient）全部改用 long/ long[] 颜色重载以绕过
		     ColorOS/Android 上 int/Color 重载触发的 ColorSpace id 非法崩溃。long 重载自 API 29 起可用，
		     故最低系统版本同步提升到 Android 10（API 29）。 -->
		<SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>
		<!-- 可空设为 annotations 模式：保留代码中的 `T?` 注解语法（避免 CS8632），
		     但关闭可空流分析（不再产生 CS8602/CS8604/CS8618 等数百条噪音告警）。
		     本项目未做系统性 null 安全，流分析告警无实际收益。 -->
		<Nullable>annotations</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- 禁用 AOT：.NET 10 + Android SDK 36.1.69 在 Release+AOT 下默认开 Marshal Methods，
		     触发 XAGNM7009（arm64 native codegen 缺失，构建失败）；仅关 Marshal Methods 虽能
		     构建但运行时 arm64 仍 SIGSEGV 静默闪退。彻底关 AOT 走 Mono 解释器才稳定可启动。
		     写入 csproj 以免任何不带 -p: 参数的重建意外重新开启 AOT。 -->
		<RunAotCompilation>false</RunAotCompilation>
		<AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
		<!-- Release 默认 RunAotCompilation=true，这里用显式 false 覆盖，避免歧义 -->
		<AndroidLinkMode>None</AndroidLinkMode>
	</PropertyGroup>

	<!-- Pure .net core layer (Domain engines, EventBus, Enums) — no UnityEngine dependency.
	     Lives under Core/ and is picked up automatically by the SDK default Compile glob. -->

	<!-- Android Assets
	     必须带 Link，否则 asset 会以完整相对路径打进包里（assets/Platforms/Android/Assets/data.json），
	     而运行时用的是 Assets.Open("data.json") —— 路径对不上，data.json 永远加载失败并静默退回内置兜底数据。
	     #43: Link 前缀不能带 "Assets\"，否则资源会落到 assets/Assets/...（data.json 变成 assets/Assets/data.json）。
	     正确写法去掉前缀，使 data.json 落到 assets/data.json，weapons/<wv>.png 落到 assets/weapons/<wv>.png。 -->
	<ItemGroup>
		<AndroidAsset Include="Platforms\Android\Assets\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Character portrait images -->
	<ItemGroup>
		<AndroidResource Include="Resources\Drawable\*.png" />
	</ItemGroup>

</Project>
