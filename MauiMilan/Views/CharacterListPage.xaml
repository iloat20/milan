<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/x"
             x:Class="Milan.Maui.Views.CharacterListPage"
             Title="角色"
             BackgroundColor="{DynamicResource DarkBg}">

    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Grid.Row="0" Padding="15" Spacing="20" HorizontalOptions="Center">
            <Label x:Name="CountLabel" Text="角色: 0" TextColor="White" FontSize="16" />
            <Button Text="返回" Clicked="OnBackClicked" BackgroundColor="#302b63" TextColor="White" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1" x:Name="CharacterList" Margin="15">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#2d1b69" Padding="12" Margin="0,6" CornerRadius="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Frame Grid.Column="0" WidthRequest="50" HeightRequest="50"
                                   BackgroundColor="{Binding RarityColor}" CornerRadius="8"
                                   Padding="0" />
                            <VerticalStackLayout Grid.Column="1" Padding="10,0">
                                <Label Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding Info}" TextColor="#aaa" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="+" Clicked="OnTrainClicked"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="{DynamicResource Primary}" TextColor="White"
                                    WidthRequest="40" HeightRequest="40" CornerRadius="20" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
