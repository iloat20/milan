<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/x"
             x:Class="Milan.Maui.Views.BattlePage"
             Title="战斗"
             BackgroundColor="{DynamicResource DarkBg}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="20">
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="20">
            <Label x:Name="TeamLabel" Text="队伍: 0 角色" TextColor="White" FontSize="16" />
            <Button Text="返回" Clicked="OnBackClicked" BackgroundColor="#302b63" TextColor="White" />
        </HorizontalStackLayout>

        <Frame Grid.Row="1" BackgroundColor="#2d1b69" Padding="20" CornerRadius="15">
            <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                <Label x:Name="StatsLabel"
                       Text="总攻击: 0&#10;总生命: 0"
                       TextColor="White"
                       FontSize="18"
                       HorizontalOptions="Center" />
                <Label x:Name="ResultLabel"
                       Text="点击开始战斗"
                       TextColor="{DynamicResource Accent}"
                       FontSize="22"
                       HorizontalOptions="Center"
                       FontAttributes="Bold" />
            </VerticalStackLayout>
        </Frame>

        <Button Grid.Row="2"
                Text="开 始 战 斗"
                Clicked="OnStartClicked"
                BackgroundColor="{DynamicResource Primary}"
                TextColor="White"
                FontSize="20"
                HeightRequest="56"
                CornerRadius="12" />
    </Grid>

</ContentPage>
