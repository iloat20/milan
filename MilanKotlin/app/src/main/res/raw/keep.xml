<?xml version="1.0" encoding="utf-8"?>
<!--
  阻止 R8 shrinkResources 误删动态引用的立绘/头像资源。

  背景：PortraitImage 用 context.resources.getIdentifier(...) 动态加载
  drawable/char_*.webp（全身立绘）与 drawable/avatar_*.webp（256 裁脸头像，2026-09-09），
  资源收缩器静态分析不到这些引用，导致 Release 包把资源全部删光（Debug 正常、Release 全灭）。
  tools:keep 通配模式是 AGP 官方机制，缺它 Release 资源必然再次消失。
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/char_*,@drawable/avatar_*" />
